<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MyPersonalTool.Controls"
        x:Class="MyPersonalTool.PetWindow"
        x:CompileBindings="False"
        Title="电子宠物"
        Width="160" MinWidth="120"
        Height="160" MinHeight="120"
        WindowStartupLocation="Manual"
        WindowDecorations="None"
        Topmost="True"
        ShowInTaskbar="False"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        PointerPressed="OnWindowPointerPressed">

  <Grid DragDrop.AllowDrop="True"
        DragDrop.DragEnter="OnDragEnter"
        DragDrop.DragLeave="OnDragLeave"
        DragDrop.Drop="OnDrop">
    <!-- 统一外部气泡（替代内部气泡 + 旧 Popup） -->
    <Popup x:Name="BubblePopup"
           Placement="Top"
           PlacementTarget="{Binding ElementName=PetBody}"
           IsOpen="{Binding IsAnyBubbleVisible}"
           HorizontalOffset="0"
           VerticalOffset="-8"
           WindowManagerAddShadowHint="False">
      <Border Background="{DynamicResource BgOverlay}"
              BorderBrush="{DynamicResource BorderColor}"
              BorderThickness="1"
              CornerRadius="12"
              Padding="14,8"
              MaxWidth="220">
        <StackPanel>
          <!-- Reaction 模式：大号 emoji -->
          <TextBlock Text="{Binding CurrentReaction}"
                     FontSize="22"
                     HorizontalAlignment="Center"
                     IsVisible="{Binding IsReacting}" />
          <!-- Thought 模式：助理名 + 文字 -->
          <Grid IsVisible="{Binding IsShowingThought}">
            <Grid RowDefinitions="Auto,Auto">
              <Grid ColumnDefinitions="Auto,*">
                <TextBlock Text="💬" FontSize="12" VerticalAlignment="Center" />
                <TextBlock Text="{Binding ThoughtAssistant}"
                           FontSize="10" FontWeight="Bold"
                           Foreground="#AAAAAA" Margin="4,0,0,0"
                           VerticalAlignment="Center" />
              </Grid>
              <TextBlock Grid.Row="1" Text="{Binding ThoughtText}"
                         FontSize="11" Foreground="{DynamicResource TextPrimary}"
                         TextWrapping="Wrap" MaxHeight="60" Margin="0,4,0,0" />
            </Grid>
          </Grid>
        </StackPanel>
      </Border>
    </Popup>

    <!-- 宠物主体 -->
    <Border x:Name="PetBody"
            Width="100" Height="100"
            CornerRadius="50"
            Background="Transparent"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            PointerPressed="OnPetPointerPressed"
            ContextRequested="OnPetContextRequested">
      <controls:SpritesheetView x:Name="PetSprite"
                                Spritesheet="{Binding SpritesheetPath}"
                                CurrentRow="{Binding AnimCurrentRow}"
                                FrameWidth="{Binding AnimFrameWidth}"
                                FrameHeight="{Binding AnimFrameHeight}"
                                Columns="{Binding AnimColumns}"
                                Width="80" Height="80"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
    </Border>
  </Grid>
</Window>
