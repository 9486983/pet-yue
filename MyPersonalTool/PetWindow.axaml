<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MyPersonalTool.Controls"
        x:Class="MyPersonalTool.PetWindow"
        x:CompileBindings="False"
        Title="电子宠物"
        Width="160" MinWidth="120"
        Height="160" MinHeight="120"
        WindowStartupLocation="Manual"
        WindowDecorations="None"
        Topmost="True"
        ShowInTaskbar="False"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        PointerPressed="OnWindowPointerPressed">

  <Grid>
    <!-- AI 对话气泡 -->
    <Border CornerRadius="12"
            Background="#CC2D2D3F"
            BorderBrush="#3D3D5C"
            BorderThickness="1"
            Padding="10,8"
            MaxWidth="220"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="0,4,0,0"
            IsVisible="{Binding IsShowingThought}">
      <Grid RowDefinitions="Auto,Auto">
        <Grid ColumnDefinitions="Auto,*">
          <TextBlock Text="💬" FontSize="12" VerticalAlignment="Center" />
          <TextBlock Text="{Binding ThoughtAssistant}"
                     FontSize="10" FontWeight="Bold"
                     Foreground="#AAAAAA" Margin="4,0,0,0"
                     VerticalAlignment="Center" />
        </Grid>
        <TextBlock Grid.Row="1" Text="{Binding ThoughtText}"
                   FontSize="11" Foreground="White"
                   TextWrapping="Wrap" MaxHeight="60" Margin="0,4,0,0" />
      </Grid>
    </Border>

    <!-- 独立弹出式反应气泡（Popup 窗口，不占宠物窗布局） -->
    <Popup x:Name="ReactionPopup"
           Placement="Top"
           PlacementTarget="{Binding ElementName=PetBody}"
           IsOpen="{Binding IsReacting}"
           HorizontalOffset="0"
           VerticalOffset="-8"
           WindowManagerAddShadowHint="False">
      <Border Background="White"
              BorderBrush="Black"
              BorderThickness="2"
              CornerRadius="12"
              Padding="14,8">
        <StackPanel>
          <TextBlock Text="{Binding CurrentReaction}"
                     FontSize="22"
                     HorizontalAlignment="Center"
                     Foreground="Black" />
          <Path Data="M 0,0 L 8,8 L 16,0 Z"
                Fill="White"
                Stroke="Black"
                StrokeThickness="1"
                HorizontalAlignment="Center"
                Margin="0,-1,0,0" />
        </StackPanel>
      </Border>
    </Popup>

    <!-- 宠物主体 -->
    <Border x:Name="PetBody"
            Width="100" Height="100"
            CornerRadius="50"
            Background="Transparent"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            PointerPressed="OnPetPointerPressed"
            ContextRequested="OnPetContextRequested">
      <controls:SpritesheetView x:Name="PetSprite"
                                Spritesheet="{Binding SpritesheetPath}"
                                CurrentRow="{Binding AnimCurrentRow}"
                                FrameWidth="{Binding AnimFrameWidth}"
                                FrameHeight="{Binding AnimFrameHeight}"
                                Columns="{Binding AnimColumns}"
                                Width="80" Height="80"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
    </Border>
  </Grid>
</Window>
