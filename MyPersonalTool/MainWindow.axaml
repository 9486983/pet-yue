<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:MyPersonalTool.Views"
        x:Class="MyPersonalTool.MainWindow"
        x:CompileBindings="False"
        Title="我的工具"
        Width="420"
        MinWidth="360"
        MaxWidth="600"
        Height="768"
        MinHeight="500"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="None"
        TransparencyLevelHint="AcrylicBlur">

  <Border CornerRadius="12" BorderThickness="1" BorderBrush="#2D2D3F">
    <Grid RowDefinitions="50,*,60">
      <!-- 标题栏 -->
      <Border Background="#CC2D2D3F"
              BoxShadow="0 2 8 #1A000000"
              PointerPressed="TitleBar_OnPointerPressed"
              CornerRadius="12,12,0,0">
        <Grid ColumnDefinitions="*,Auto,Auto,Auto">
          <TextBlock Text="My Personal Tool"
                     FontSize="16"
                     FontWeight="SemiBold"
                     VerticalAlignment="Center"
                     Margin="16,0"
                     Foreground="White" />

          <Button x:Name="MinimizeBtn"
                  Grid.Column="1"
                  Content="─"
                  Width="46" Height="32"
                  FontSize="14"
                  Foreground="White"
                  Background="Transparent"
                  BorderThickness="0"
                  Cursor="Hand"
                  CornerRadius="0" />
          <Button x:Name="MaximizeBtn"
                  Grid.Column="2"
                  Content="⛶"
                  Width="46" Height="32"
                  FontSize="14"
                  Foreground="White"
                  Background="Transparent"
                  BorderThickness="0"
                  Cursor="Hand"
                  CornerRadius="0" />
          <Button x:Name="CloseBtn"
                  Grid.Column="3"
                  Content="✕"
                  Width="46" Height="32"
                  FontSize="14"
                  Foreground="White"
                  Background="Transparent"
                  BorderThickness="0"
                  Cursor="Hand"
                  CornerRadius="0" />
        </Grid>
      </Border>

      <!-- 内容区域 -->
      <Grid Grid.Row="1" Background="#CC1A1A2E">
        <ScrollViewer IsVisible="{Binding IsHomeSelected}">
          <views:HomePage Margin="16" />
        </ScrollViewer>
        <ScrollViewer IsVisible="{Binding IsSettingsSelected}">
          <views:SettingsPage Margin="16" />
        </ScrollViewer>
      </Grid>

      <!-- 底部导航 -->
      <Border Grid.Row="2"
              Background="#CC2D2D3F"
              BoxShadow="0 -2 8 #1A000000"
              CornerRadius="0,0,12,12">
        <Grid ColumnDefinitions="*,*">
          <Button Command="{Binding GoToHomeCommand}"
                  Background="Transparent"
                  BorderThickness="0"
                  Cursor="Hand"
                  FontSize="13"
                  CornerRadius="0">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
              <TextBlock Text="Home" FontSize="20" HorizontalAlignment="Center" />
              <TextBlock Text="首页" FontSize="11" HorizontalAlignment="Center" Foreground="#CCFFFFFF" />
            </StackPanel>
          </Button>

          <Button Grid.Column="1"
                  Command="{Binding GoToSettingsCommand}"
                  Background="Transparent"
                  BorderThickness="0"
                  Cursor="Hand"
                  FontSize="13"
                  CornerRadius="0">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
              <TextBlock Text="Settings" FontSize="20" HorizontalAlignment="Center" />
              <TextBlock Text="设置" FontSize="11" HorizontalAlignment="Center" Foreground="#CCFFFFFF" />
            </StackPanel>
          </Button>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
