<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MyPersonalTool.Views.SettingsPage"
             x:CompileBindings="False">
  <StackPanel Spacing="16" HorizontalAlignment="Center">
    <TextBlock Text="⚙️ 设置"
               FontSize="20"
               FontWeight="Bold"
               Foreground="White"
               HorizontalAlignment="Center" />

    <!-- Module 1: 主题设置（默认展开） -->
    <Expander IsExpanded="True" Width="340">
      <Expander.Header>
        <TextBlock Text="🎨 主题设置"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Foreground="White" />
      </Expander.Header>
      <StackPanel Spacing="10" HorizontalAlignment="Center" Margin="0,10,0,0">
        <Grid ColumnDefinitions="*,Auto" Width="280">
          <TextBlock Text="深色模式"
                     Foreground="#AAFFFFFF"
                     VerticalAlignment="Center"
                     FontSize="13" />
          <ToggleSwitch Grid.Column="1"
                        IsChecked="{Binding Config.IsDarkTheme}"
                        OffContent="☀️"
                        OnContent="🌙" />
        </Grid>
      </StackPanel>
    </Expander>

    <!-- Module 2: 启动设置（默认展开） -->
    <Expander IsExpanded="True" Width="340">
      <Expander.Header>
        <TextBlock Text="🚀 启动设置"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Foreground="White" />
      </Expander.Header>
      <StackPanel Spacing="10" HorizontalAlignment="Center" Margin="0,10,0,0">
        <Grid ColumnDefinitions="*,Auto" Width="280">
          <TextBlock Text="开机自启动"
                     Foreground="#AAFFFFFF"
                     VerticalAlignment="Center"
                     FontSize="13" />
          <ToggleSwitch Grid.Column="1"
                        x:Name="AutoStartToggle"
                        IsChecked="{Binding Config.EnableAutoStart}"
                        OffContent="❌"
                        OnContent="✅" />
        </Grid>
      </StackPanel>
    </Expander>

    <!-- Module 3: 窗口设置（默认展开） -->
    <Expander IsExpanded="True" Width="340">
      <Expander.Header>
        <TextBlock Text="📐 窗口设置"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Foreground="White" />
      </Expander.Header>
      <Grid ColumnDefinitions="70,*" RowDefinitions="Auto,Auto" RowSpacing="10" Width="280" Margin="0,10,0,0">
        <TextBlock Text="宽度:"
                   Foreground="#AAFFFFFF"
                   VerticalAlignment="Center" />
        <TextBox Grid.Column="1"
                 Text="{Binding Config.WindowWidth}"
                 PlaceholderText="420"
                 Foreground="White"
                 Background="#1A1A2E"
                 BorderBrush="#3D3D5C"
                 CornerRadius="8" />

        <TextBlock Grid.Row="1" Text="高度:"
                   Foreground="#AAFFFFFF"
                   VerticalAlignment="Center" />
        <TextBox Grid.Row="1" Grid.Column="1"
                 Text="{Binding Config.WindowHeight}"
                 PlaceholderText="768"
                 Foreground="White"
                 Background="#1A1A2E"
                 BorderBrush="#3D3D5C"
                 CornerRadius="8" />
      </Grid>
    </Expander>

    <!-- Module 3: 健康提醒（默认展开） -->
    <Expander IsExpanded="True" Width="340">
      <Expander.Header>
        <TextBlock Text="🧘 健康提醒"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Foreground="White" />
      </Expander.Header>
      <StackPanel Spacing="10" Margin="0,10,0,0">
        <Grid ColumnDefinitions="*,Auto" Width="280">
          <TextBlock Text="启用健康提醒"
                     Foreground="#AAFFFFFF"
                     VerticalAlignment="Center"
                     FontSize="13" />
          <ToggleSwitch Grid.Column="1"
                        IsChecked="{Binding HealthEnabled}"
                        OffContent="❌"
                        OnContent="✅" />
        </Grid>

        <Grid ColumnDefinitions="70,*,Auto" Width="280">
          <TextBlock Text="久坐"
                     Foreground="#AAFFFFFF"
                     VerticalAlignment="Center" />
          <Slider Grid.Column="1"
                  Minimum="15" Maximum="120"
                  Value="{Binding SitInterval, Mode=TwoWay}"
                  IsSnapToTickEnabled="True" TickFrequency="5"
                  Margin="8,0" />
          <TextBlock Grid.Column="2"
                     Text="{Binding SitInterval, StringFormat={}{0}分钟}"
                     FontSize="11"
                     Foreground="#88FFFFFF"
                     VerticalAlignment="Center"
                     Width="50"
                     TextAlignment="Center" />
        </Grid>

        <Grid ColumnDefinitions="70,*,Auto" Width="280">
          <TextBlock Text="用眼"
                     Foreground="#AAFFFFFF"
                     VerticalAlignment="Center" />
          <Slider Grid.Column="1"
                  Minimum="10" Maximum="90"
                  Value="{Binding EyeInterval, Mode=TwoWay}"
                  IsSnapToTickEnabled="True" TickFrequency="5"
                  Margin="8,0" />
          <TextBlock Grid.Column="2"
                     Text="{Binding EyeInterval, StringFormat={}{0}分钟}"
                     FontSize="11"
                     Foreground="#88FFFFFF"
                     VerticalAlignment="Center"
                     Width="50"
                     TextAlignment="Center" />
        </Grid>

        <Grid ColumnDefinitions="70,*,Auto" Width="280">
          <TextBlock Text="喝水"
                     Foreground="#AAFFFFFF"
                     VerticalAlignment="Center" />
          <Slider Grid.Column="1"
                  Minimum="15" Maximum="120"
                  Value="{Binding DrinkInterval, Mode=TwoWay}"
                  IsSnapToTickEnabled="True" TickFrequency="5"
                  Margin="8,0" />
          <TextBlock Grid.Column="2"
                     Text="{Binding DrinkInterval, StringFormat={}{0}分钟}"
                     FontSize="11"
                     Foreground="#88FFFFFF"
                     VerticalAlignment="Center"
                     Width="50"
                     TextAlignment="Center" />
        </Grid>
      </StackPanel>
    </Expander>

    <!-- Module 4: 宠物设置（默认折叠） -->
    <Expander IsExpanded="False" Width="340">
      <Expander.Header>
        <TextBlock Text="🐱 宠物设置"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Foreground="White" />
      </Expander.Header>
      <StackPanel Spacing="10" Margin="0,10,0,0">
        <Grid ColumnDefinitions="70,*" Width="280">
          <TextBlock Text="名字:"
                     Foreground="#AAFFFFFF"
                     VerticalAlignment="Center" />
          <TextBox Grid.Column="1"
                   Text="{Binding Config.PetName}"
                   PlaceholderText="小宠"
                   Foreground="White"
                   Background="#1A1A2E"
                   BorderBrush="#3D3D5C"
                   CornerRadius="8" />
        </Grid>

        <Grid ColumnDefinitions="70,*,Auto" Width="280">
          <TextBlock Text="动画速度"
                     Foreground="#AAFFFFFF"
                     VerticalAlignment="Center" />
          <Slider Grid.Column="1"
                  Minimum="30" Maximum="300"
                  Value="{Binding AnimSpeed, Mode=TwoWay}"
                  IsSnapToTickEnabled="True"
                  TickFrequency="10"
                  Margin="8,0" />
          <TextBlock Grid.Column="2"
                     Text="{Binding AnimSpeed, StringFormat={}{0:0}ms}"
                     FontSize="12"
                     Foreground="#88FFFFFF"
                     VerticalAlignment="Center" />
        </Grid>
      </StackPanel>
    </Expander>

    <!-- Module 4: 宠物动作管理（默认折叠） -->
    <Expander IsExpanded="False" Width="340">
      <Expander.Header>
        <TextBlock Text="🎮 宠物动作（可配置）"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Foreground="White" />
      </Expander.Header>
      <ItemsControl ItemsSource="{Binding Config.PetActions}"
                    x:CompileBindings="False"
                    Margin="0,10,0,0">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border CornerRadius="10" Background="#1A1A2E" Padding="12" Margin="0,0,0,6">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock Text="{Binding Emoji}" FontSize="22" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                  <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="White" />
                  <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#88FFFFFF" />
                </StackPanel>
                <TextBlock Grid.Column="2"
                           Text="{Binding Reaction}"
                           FontSize="18"
                           VerticalAlignment="Center" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Expander>

    <!-- 保存按钮 -->
    <Button Content="💾 保存设置"
            Command="{Binding SaveConfigCommand}"
            Width="340" Height="42"
            CornerRadius="12"
            Background="#667eea"
            BorderThickness="0"
            FontSize="14"
            FontWeight="SemiBold"
            Foreground="White"
            Cursor="Hand"
            HorizontalContentAlignment="Center">
      <Button.Styles>
        <Style Selector="Button:hover">
          <Setter Property="Background" Value="#7B93F5" />
        </Style>
        <Style Selector="Button:pressed">
          <Setter Property="Background" Value="#5568C9" />
        </Style>
      </Button.Styles>
    </Button>

    <TextBlock Text="v1.0.0 · 用 ❤️ 和 Avalonia 构建"
               FontSize="11"
               Foreground="#66FFFFFF"
               HorizontalAlignment="Center"
               Margin="0,4,0,0" />
  </StackPanel>
</UserControl>
